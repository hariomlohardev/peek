Output assets/demo.gif
Set Width 1200
Set Height 800
Set Theme "Catppuccin Mocha"
Set FontSize 14
Set Padding 10

# Primary: code-generated via Pillow — python -m peek.tools.gen_demo
# This tape is the vhs fallback (requires `vhs` binary). Both produce same flow.

Type "peek --help" Enter
Sleep 1000ms
Type "peek . --no-tui" Enter
Sleep 2000ms
Type "peek find \"auth\" ." Enter
Sleep 1500ms
Type "peek --pack --ask \"auth\" | head -20" Enter
Sleep 1500ms
Type "peek --theme-list" Enter
Sleep 1200ms
